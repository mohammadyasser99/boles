{
  "version": 2,
  "builds": [
    {
      "src": "dist/car-rental-frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/*.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}